{
	"name": "@michaelrwalker/doc-site",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"//": "Binaries are invoked by path, not by name: this directory's POSIX name contains a colon, which splits npm's PATH injection and makes bare `astro` unresolvable.",
	"scripts": {
		"sync": "node scripts/sync-docs.ts",
		"sync:remote": "node scripts/sync-docs.ts --remote",
		"dev": "node scripts/sync-docs.ts && ./node_modules/.bin/astro dev",
		"build": "node scripts/sync-docs.ts --remote && ./node_modules/.bin/astro build && ./node_modules/.bin/pagefind --site dist",
		"build:local": "node scripts/sync-docs.ts && ./node_modules/.bin/astro build && ./node_modules/.bin/pagefind --site dist",
		"preview": "./node_modules/.bin/astro preview",
		"check": "./node_modules/.bin/astro check",
		"format": "./node_modules/.bin/biome format --write",
		"fix": "./node_modules/.bin/biome lint --write"
	},
	"dependencies": {
		"@astrojs/mdx": "^4.3.6",
		"@astrojs/sitemap": "^3.6.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@michaelrwalker/stagehand": "^0.5.2",
		"astro": "^5.16.2",
		"pagefind": "^1.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "2.5.5",
		"@types/node": "^26.1.1",
		"typescript": "^5.9.3"
	},
	"allowScripts": {
		"esbuild@0.27.7": true,
		"esbuild@0.25.12": true,
		"fsevents@2.3.3": true,
		"sharp@0.34.5": true
	}
}
