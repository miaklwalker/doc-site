{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*.ts", "**/*.astro"],
	"exclude": ["dist", "node_modules", ".clones", "docs-cache"],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"types": ["node"]
	}
}
