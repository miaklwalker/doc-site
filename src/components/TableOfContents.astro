---
import type { MarkdownHeading } from "astro";

type Props = { headings: MarkdownHeading[]; editUrl?: string };
const { headings, editUrl } = Astro.props;

// h2/h3 only — deeper nesting makes the rail noisy rather than useful.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="toc scroll-area" aria-label="On this page">
	{
		items.length > 0 && (
			<>
				<h2 class="toc-heading">On this page</h2>
				<ul class="toc-list">
					{items.map((h) => (
						<li>
							<a class="toc-link" data-depth={h.depth} href={`#${h.slug}`} data-toc-link={h.slug}>
								{h.text}
							</a>
						</li>
					))}
				</ul>
			</>
		)
	}

	{
		editUrl && (
			<a class="toc-edit" href={editUrl} target="_blank" rel="noreferrer noopener">
				<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
				</svg>
				Edit this page
			</a>
		)
	}
</aside>

<style>
	.toc {
		position: sticky;
		top: var(--header-h);
		align-self: start;
		width: var(--toc-w);
		max-height: calc(100dvh - var(--header-h));
		overflow-y: auto;
		padding: 1.75rem 0 3rem 1.5rem;
		flex-shrink: 0;
	}

	.toc-heading {
		margin-bottom: 0.55rem;
		font-size: 0.6875rem;
		font-weight: 650;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--text-faint);
	}

	.toc-list {
		list-style: none;
		padding: 0;
		border-left: 1px solid var(--border);
		display: flex;
		flex-direction: column;
	}

	.toc-link {
		display: block;
		padding: 0.26rem 0 0.26rem 0.75rem;
		margin-left: -1px;
		border-left: 1px solid transparent;
		font-size: 0.8125rem;
		line-height: 1.45;
		color: var(--text-faint);
		text-wrap: pretty;
		transition: color 0.13s var(--ease), border-color 0.13s var(--ease);
	}
	.toc-link[data-depth="3"] {
		padding-left: 1.5rem;
		font-size: 0.7813rem;
	}
	.toc-link:hover {
		color: var(--text);
	}
	.toc-link[data-active="true"] {
		color: var(--accent);
		border-left-color: var(--accent);
	}

	.toc-edit {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1.5rem;
		font-size: 0.8125rem;
		color: var(--text-faint);
		transition: color 0.15s var(--ease);
	}
	.toc-edit:hover {
		color: var(--accent);
	}

	@media (max-width: 1280px) {
		.toc {
			display: none;
		}
	}
</style>

<script>
	// Highlight the heading currently in view.
	const links = new Map<string, HTMLElement>();
	for (const el of document.querySelectorAll<HTMLElement>("[data-toc-link]")) {
		links.set(el.dataset.tocLink as string, el);
	}

	if (links.size) {
		const visible = new Set<string>();

		const setActive = (id: string | null) => {
			for (const [slug, el] of links) el.dataset.active = String(slug === id);
		};

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const id = entry.target.id;
					if (entry.isIntersecting) visible.add(id);
					else visible.delete(id);
				}
				// Pick the first heading (in document order) that is on screen.
				const first = [...links.keys()].find((slug) => visible.has(slug));
				if (first) setActive(first);
			},
			{ rootMargin: "-80px 0px -70% 0px", threshold: 0 },
		);

		for (const slug of links.keys()) {
			const heading = document.getElementById(slug);
			if (heading) observer.observe(heading);
		}
	}
</script>
