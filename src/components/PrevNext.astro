---
import type { NavLink } from "../lib/nav.ts";

type Props = { prev?: NavLink; next?: NavLink };
const { prev, next } = Astro.props;
---

{
	(prev || next) && (
		<nav class="prev-next" aria-label="Page navigation">
			{prev ? (
				<a class="pn-card" href={prev.url} rel="prev">
					<span class="pn-label">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<path d="m15 18-6-6 6-6" />
						</svg>
						Previous
					</span>
					<span class="pn-title">{prev.label}</span>
				</a>
			) : (
				<span />
			)}

			{next && (
				<a class="pn-card pn-next" href={next.url} rel="next">
					<span class="pn-label">
						Next
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
							<path d="m9 18 6-6-6-6" />
						</svg>
					</span>
					<span class="pn-title">{next.label}</span>
				</a>
			)}
		</nav>
	)
}

<style>
	.prev-next {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		margin-top: 3.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.pn-card {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		padding: 0.875rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		transition: border-color 0.15s var(--ease), background 0.15s var(--ease);
	}
	.pn-card:hover {
		border-color: var(--accent);
		background: var(--bg-subtle);
	}

	.pn-next {
		align-items: flex-end;
		text-align: right;
	}

	.pn-label {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.75rem;
		color: var(--text-faint);
	}

	.pn-title {
		font-size: 0.875rem;
		font-weight: 550;
		color: var(--text);
	}

	@media (max-width: 640px) {
		.prev-next {
			grid-template-columns: 1fr;
		}
	}
</style>
