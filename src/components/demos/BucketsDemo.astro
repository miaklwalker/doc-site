---
/**
 * A stream of items flows into the engine and leaves it classified into three
 * buckets. Motion uses SVG <animateMotion>, which every target browser has
 * supported for years — CSS offset-path is newer and this needs to be boring.
 */
const PATHS = [
	{ id: "bk-a", d: "M14,120 H244 C288,120 296,58 348,58", colour: "#fbbf24", bucket: 0 },
	{ id: "bk-b", d: "M14,120 H244 C288,120 300,120 348,120", colour: "#34d399", bucket: 1 },
	{ id: "bk-c", d: "M14,120 H244 C288,120 296,182 348,182", colour: "#fb7185", bucket: 2 },
];

const BUCKETS = [
	{ label: "warehouse", y: 58, colour: "#fbbf24" },
	{ label: "digital", y: 120, colour: "#34d399" },
	{ label: "incomplete", y: 182, colour: "#fb7185" },
];

// Staggered so the three streams never arrive in lockstep.
const DOTS = [
	{ path: "bk-a", begin: "0s" },
	{ path: "bk-b", begin: "0.55s" },
	{ path: "bk-c", begin: "1.1s" },
	{ path: "bk-b", begin: "1.65s" },
	{ path: "bk-a", begin: "2.2s" },
	{ path: "bk-c", begin: "2.75s" },
];

const DUR = "3.3s";
const CYCLE = 3.3;
---

<div class="demo" data-buckets-demo>
	<svg
		viewBox="0 0 440 240"
		role="img"
		aria-label="Items stream into the bucket engine and are sorted into warehouse, digital and incomplete buckets"
		data-svg
	>
		<defs>
			{PATHS.map((p) => <path id={p.id} d={p.d} fill="none" />)}
		</defs>

		{/* rails */}
		{
			PATHS.map((p) => (
				<use href={`#${p.id}`} class="rail" />
			))
		}

		{/* engine */}
		<g class="engine">
			<rect x="120" y="92" width="106" height="56" rx="11" />
			<text x="173" y="116" text-anchor="middle" class="engine-label">BucketEngine</text>
			<text x="173" y="132" text-anchor="middle" class="engine-sub">3 conditions</text>
		</g>

		{/* buckets */}
		{
			BUCKETS.map((b, i) => (
				<g class="bucket" style={`--bucket:${b.colour}`}>
					<rect x="348" y={b.y - 21} width="80" height="42" rx="9" />
					<text x="388" y={b.y - 2} text-anchor="middle" class="bucket-label">
						{b.label}
					</text>
					<text x="388" y={b.y + 12} text-anchor="middle" class="bucket-count" data-count={i}>
						0
					</text>
				</g>
			))
		}

		{/* items in flight */}
		{
			DOTS.map((dot) => {
				const path = PATHS.find((p) => p.id === dot.path);
				return (
					<circle r="5" class="item" fill="#a1a1aa" visibility="hidden">
						{/* stay hidden at the (0,0) origin until motion actually starts */}
						<set attributeName="visibility" to="visible" begin={dot.begin} />
						<animateMotion dur={DUR} begin={dot.begin} repeatCount="indefinite" rotate="auto">
							<mpath href={`#${dot.path}`} />
						</animateMotion>
						{/* grey until it leaves the engine, then the bucket's colour */}
						<animate
							attributeName="fill"
							values={`#a1a1aa;#a1a1aa;${path?.colour};${path?.colour}`}
							keyTimes="0;0.58;0.63;1"
							dur={DUR}
							begin={dot.begin}
							repeatCount="indefinite"
						/>
						<animate
							attributeName="r"
							values="5;5;3.2;5;5"
							keyTimes="0;0.45;0.55;0.63;1"
							dur={DUR}
							begin={dot.begin}
							repeatCount="indefinite"
						/>
					</circle>
				);
			})
		}
	</svg>
</div>

<style>
	.demo {
		container-type: inline-size;
	}

	svg {
		width: 100%;
		height: auto;
		display: block;
		font-family: var(--font-mono);
	}

	.rail {
		stroke: var(--border-strong);
		stroke-width: 1.5;
		stroke-dasharray: 3 5;
		fill: none;
		opacity: 0.7;
	}

	.engine rect {
		fill: var(--bg-elevated);
		stroke: var(--card, #f59e0b);
		stroke-width: 1.5;
	}
	.engine-label {
		font-size: 11px;
		font-weight: 600;
		fill: var(--text);
	}
	.engine-sub {
		font-size: 8.5px;
		fill: var(--text-faint);
	}

	.bucket rect {
		fill: color-mix(in oklab, var(--bucket) 12%, transparent);
		stroke: color-mix(in oklab, var(--bucket) 55%, transparent);
		stroke-width: 1.5;
	}
	.bucket-label {
		font-size: 9px;
		font-weight: 600;
		fill: var(--bucket);
	}
	.bucket-count {
		font-size: 8.5px;
		fill: var(--text-faint);
	}

	.item {
		filter: drop-shadow(0 0 4px currentColor);
	}

	@media (prefers-reduced-motion: reduce) {
		.item {
			display: none;
		}
	}
</style>

<script>
	// Tick the bucket tallies roughly in time with the arriving items, and stop
	// the whole thing when it is off screen or the visitor asked for less motion.
	const root = document.querySelector<HTMLElement>("[data-buckets-demo]");
	const svg = root?.querySelector("svg") as SVGSVGElement | null;

	if (root && svg) {
		const counters = [...root.querySelectorAll<SVGTextElement>("[data-count]")];
		const tallies = counters.map(() => 0);
		const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		// Two items land in each bucket per 3.3s cycle, offset per stream.
		const OFFSETS = [0, 550, 1100];
		let timers: number[] = [];

		const start = () => {
			if (reduced || timers.length) return;
			svg.unpauseAnimations();
			timers = OFFSETS.map((offset, i) =>
				window.setTimeout(() => {
					const tick = () => {
						tallies[i] += 1;
						counters[i].textContent = String(tallies[i]);
					};
					tick();
					timers.push(window.setInterval(tick, 1650));
				}, offset + 3300),
			);
		};

		const stop = () => {
			svg.pauseAnimations();
			for (const t of timers) {
				clearTimeout(t);
				clearInterval(t);
			}
			timers = [];
		};

		if (reduced) {
			svg.pauseAnimations();
		} else {
			// Run by default and let the observer *pause* when off screen. Starting
			// only on intersection would leave a dead frame anywhere the observer
			// does not fire, and a blank demo is worse than a slightly early one.
			start();
			new IntersectionObserver(
				(entries) => {
					for (const entry of entries) entry.isIntersecting ? start() : stop();
				},
				{ threshold: 0.2 },
			).observe(root);
		}
	}
</script>
