---
import { href } from "../lib/links.ts";
import type { NavSection } from "../lib/nav.ts";
import type { Library } from "../lib/registry.ts";

type Props = { nav: NavSection[]; library: Library; currentId?: string };
const { nav, library, currentId } = Astro.props;
---

<aside class="sidebar scroll-area" data-sidebar aria-label={`${library.name} documentation`}>
	<a class="sidebar-lib" href={href(library.id)}>
		<span class="sidebar-lib-name">{library.name}</span>
		<span class="sidebar-lib-pkg">{library.package}</span>
	</a>

	<nav class="sidebar-nav">
		{
			nav.map((section) => (
				<section class="sidebar-section">
					<h2 class="sidebar-heading">{section.label}</h2>
					<ul class="sidebar-list">
						{section.links.map((link) => (
							<li>
								<a
									class="sidebar-link"
									href={link.url}
									aria-current={link.entryId && link.entryId === currentId ? "page" : undefined}
									{...(link.external ? { target: "_blank", rel: "noreferrer noopener" } : {})}
								>
									<span>{link.label}</span>
									{link.badge && <span class="sidebar-badge">{link.badge}</span>}
									{link.external && (
										<svg class="sidebar-ext" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
											<path d="M7 17 17 7M9 7h8v8" />
										</svg>
									)}
								</a>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</nav>
</aside>

<div class="sidebar-scrim" data-sidebar-scrim hidden></div>

<style>
	.sidebar {
		position: sticky;
		top: var(--header-h);
		align-self: start;
		width: var(--sidebar-w);
		height: calc(100dvh - var(--header-h));
		overflow-y: auto;
		padding: 1.75rem 1rem 3rem 0;
		flex-shrink: 0;
	}

	.sidebar-lib {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0 0.7rem 1.25rem;
		margin-bottom: 0.5rem;
		border-bottom: 1px solid var(--border);
	}
	.sidebar-lib-name {
		font-size: 0.9375rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		color: var(--text);
	}
	.sidebar-lib-pkg {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--text-faint);
	}

	.sidebar-nav {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.sidebar-heading {
		padding-inline: 0.7rem;
		margin-bottom: 0.4rem;
		font-size: 0.6875rem;
		font-weight: 650;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--text-faint);
	}

	.sidebar-list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.sidebar-link {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.34rem 0.7rem;
		border-radius: 6px;
		font-size: 0.8438rem;
		color: var(--text-muted);
		transition: color 0.13s var(--ease), background 0.13s var(--ease);
	}
	.sidebar-link:hover {
		color: var(--text);
		background: var(--bg-subtle);
	}
	.sidebar-link[aria-current="page"] {
		color: var(--accent);
		background: color-mix(in oklab, var(--accent) 10%, transparent);
		font-weight: 550;
	}

	.sidebar-badge {
		padding: 0.05rem 0.3rem;
		border-radius: 4px;
		font-size: 0.625rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		background: color-mix(in oklab, var(--accent) 16%, transparent);
		color: var(--accent);
	}

	.sidebar-ext {
		margin-left: auto;
		color: var(--text-faint);
	}

	.sidebar-scrim {
		position: fixed;
		inset: 0;
		z-index: 39;
		background: color-mix(in oklab, #000 40%, transparent);
	}
	.sidebar-scrim[hidden] {
		display: none;
	}

	@media (max-width: 1100px) {
		.sidebar {
			position: fixed;
			top: var(--header-h);
			left: 0;
			z-index: 40;
			width: min(var(--sidebar-w), 82vw);
			padding: 1.75rem 1rem 3rem 1.25rem;
			background: var(--bg-elevated);
			border-right: 1px solid var(--border);
			transform: translateX(-102%);
			transition: transform 0.22s var(--ease);
		}
		.sidebar[data-open="true"] {
			transform: translateX(0);
		}
	}
</style>

<script>
	const sidebar = document.querySelector<HTMLElement>("[data-sidebar]");
	const scrim = document.querySelector<HTMLElement>("[data-sidebar-scrim]");

	function setOpen(open: boolean) {
		if (!sidebar || !scrim) return;
		sidebar.dataset.open = String(open);
		scrim.hidden = !open;
	}

	document.addEventListener("click", (e) => {
		const target = e.target as HTMLElement;
		if (target.closest("[data-sidebar-toggle]")) {
			setOpen(sidebar?.dataset.open !== "true");
		} else if (target.closest("[data-sidebar-scrim]") || target.closest(".sidebar-link")) {
			setOpen(false);
		}
	});

	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape") setOpen(false);
	});
</script>
