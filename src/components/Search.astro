---
// A ⌘K search modal backed by Pagefind, which indexes the built HTML after
// `astro build`. Pagefind's bundle only exists in a production build, so in
// dev the modal explains itself instead of erroring.
const pagefindBase = `${import.meta.env.BASE_URL}/pagefind/pagefind.js`.replace(/([^:])\/+/g, "$1/");
---

<div class="search-backdrop" data-search-backdrop hidden>
	<div class="search-modal" role="dialog" aria-modal="true" aria-label="Search documentation">
		<div class="search-input-row">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
				<circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
			</svg>
			<input
				type="search"
				class="search-input"
				placeholder="Search all libraries…"
				autocomplete="off"
				spellcheck="false"
				data-search-input
			/>
			<kbd class="search-esc">esc</kbd>
		</div>
		<div class="search-results scroll-area" data-search-results>
			<p class="search-hint">Start typing to search.</p>
		</div>
	</div>
</div>

<style>
	.search-backdrop {
		position: fixed;
		inset: 0;
		z-index: 90;
		display: flex;
		justify-content: center;
		padding: 5rem 1rem 1rem;
		background: color-mix(in oklab, #000 45%, transparent);
		backdrop-filter: blur(3px);
		-webkit-backdrop-filter: blur(3px);
		animation: fade 0.14s var(--ease);
	}
	.search-backdrop[hidden] {
		display: none;
	}

	@keyframes fade {
		from {
			opacity: 0;
		}
	}

	.search-modal {
		width: 100%;
		max-width: 36rem;
		max-height: min(28rem, calc(100dvh - 7rem));
		display: flex;
		flex-direction: column;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: 0 24px 60px -12px hsl(var(--shadow-color) / calc(var(--shadow-strength) + 30%));
		overflow: hidden;
		animation: pop 0.16s var(--ease);
	}

	@keyframes pop {
		from {
			opacity: 0;
			transform: translateY(-6px) scale(0.985);
		}
	}

	.search-input-row {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.875rem 1rem;
		border-bottom: 1px solid var(--border);
		color: var(--text-faint);
		flex-shrink: 0;
	}

	.search-input {
		flex: 1;
		border: 0;
		background: transparent;
		font-size: 0.9375rem;
		color: var(--text);
		outline: none;
		min-width: 0;
	}
	.search-input::placeholder {
		color: var(--text-faint);
	}
	.search-input::-webkit-search-cancel-button {
		display: none;
	}

	.search-esc {
		font-family: var(--font-sans);
		font-size: 0.6875rem;
		padding: 0.1rem 0.35rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--text-faint);
	}

	.search-results {
		overflow-y: auto;
		padding: 0.375rem;
	}

	/*
	 * Everything below is injected at runtime via innerHTML, so it never carries
	 * Astro's scoping attribute — these must be :global to apply at all.
	 */
	.search-results :global(.search-hint) {
		padding: 1.5rem 0.75rem;
		text-align: center;
		font-size: 0.8125rem;
		line-height: 1.6;
		color: var(--text-faint);
	}
	.search-results :global(.search-hint code) {
		font-family: var(--font-mono);
		font-size: 0.95em;
		padding: 0.1em 0.32em;
		border-radius: 4px;
		background: var(--bg-subtle);
		border: 1px solid var(--border);
	}

	.search-results :global(.search-result) {
		display: block;
		padding: 0.55rem 0.7rem;
		border-radius: 7px;
		transition: background 0.12s var(--ease);
	}
	.search-results :global(.search-result:hover),
	.search-results :global(.search-result:focus-visible),
	.search-results :global(.search-result[data-active="true"]) {
		background: var(--bg-subtle);
	}

	.search-results :global(.search-result-top) {
		display: flex;
		align-items: baseline;
		gap: 0.45rem;
		margin-bottom: 0.15rem;
	}
	.search-results :global(.search-result-lib) {
		flex-shrink: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--accent);
	}
	.search-results :global(.search-result-title) {
		font-size: 0.8438rem;
		font-weight: 600;
		color: var(--text);
	}
	.search-results :global(.search-result-excerpt) {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: 0.78rem;
		line-height: 1.5;
		color: var(--text-faint);
	}
	.search-results :global(.search-result-excerpt mark) {
		background: color-mix(in oklab, var(--accent) 25%, transparent);
		color: var(--text);
		border-radius: 2px;
	}
</style>

{/* is:inline is required by define:vars, and stated explicitly so the build does not have to infer it. */}
<script is:inline define:vars={{ pagefindBase }}>
	(() => {
		const backdrop = document.querySelector("[data-search-backdrop]");
		const input = document.querySelector("[data-search-input]");
		const results = document.querySelector("[data-search-results]");
		if (!backdrop || !input || !results) return;

		let pagefind = null;
		let loadFailed = false;
		let activeIndex = -1;

		async function ensurePagefind() {
			if (pagefind || loadFailed) return pagefind;
			try {
				pagefind = await import(/* @vite-ignore */ pagefindBase);
				await pagefind.options({ excerptLength: 24 });
				return pagefind;
			} catch {
				loadFailed = true;
				return null;
			}
		}

		function setHint(text) {
			results.innerHTML = `<p class="search-hint">${text}</p>`;
			activeIndex = -1;
		}

		function open() {
			backdrop.hidden = false;
			document.body.style.overflow = "hidden";
			input.focus();
			input.select();
			ensurePagefind();
		}

		function close() {
			backdrop.hidden = true;
			document.body.style.overflow = "";
		}

		document.addEventListener("click", (e) => {
			if (e.target.closest("[data-search-open]")) open();
		});

		backdrop.addEventListener("click", (e) => {
			if (e.target === backdrop) close();
		});

		document.addEventListener("keydown", (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
				e.preventDefault();
				backdrop.hidden ? open() : close();
				return;
			}
			if (backdrop.hidden) return;

			if (e.key === "Escape") {
				close();
				return;
			}

			const items = [...results.querySelectorAll(".search-result")];
			if (!items.length) return;

			if (e.key === "ArrowDown" || e.key === "ArrowUp") {
				e.preventDefault();
				activeIndex =
					e.key === "ArrowDown"
						? (activeIndex + 1) % items.length
						: (activeIndex - 1 + items.length) % items.length;
				items.forEach((el, i) => el.setAttribute("data-active", String(i === activeIndex)));
				items[activeIndex].scrollIntoView({ block: "nearest" });
			} else if (e.key === "Enter" && activeIndex >= 0) {
				e.preventDefault();
				items[activeIndex].click();
			}
		});

		let token = 0;

		input.addEventListener("input", async () => {
			const query = input.value.trim();
			const mine = ++token;

			if (!query) return setHint("Start typing to search.");

			const pf = await ensurePagefind();
			if (mine !== token) return;

			if (!pf) {
				return setHint("Search index is built with the site — run <code>npm run build</code> to try it locally.");
			}

			const search = await pf.search(query);
			if (mine !== token) return;

			if (!search.results.length) {
				return setHint(`No results for “${query.replace(/</g, "&lt;")}”.`);
			}

			const data = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
			if (mine !== token) return;

			activeIndex = -1;
			results.innerHTML = data
				.map((d) => {
					const library = d.meta?.library ?? "";
					const title = d.meta?.title ?? d.excerpt.slice(0, 60);
					return `<a class="search-result" href="${d.url}">
						<span class="search-result-top">
							${library ? `<span class="search-result-lib">${library}</span>` : ""}
							<span class="search-result-title">${title}</span>
						</span>
						<span class="search-result-excerpt">${d.excerpt}</span>
					</a>`;
				})
				.join("");
		});
	})();
</script>
