---
import { href } from "../lib/links.ts";
import { type Library, loadRegistry } from "../lib/registry.ts";

type Props = { library?: Library };
const { library } = Astro.props;

const libraries = loadRegistry();
const repoUrl = library ? `https://github.com/${library.repo}` : "https://github.com/miaklwalker";
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href={href()} aria-label="Home">
			<span class="brand-mark" aria-hidden="true">@</span>
			<span class="brand-name">michaelrwalker</span>
		</a>

		{
			library && (
				<>
					<span class="brand-divider" aria-hidden="true">/</span>
					<div class="lib-switcher">
						<button type="button" class="lib-trigger" aria-expanded="false" aria-haspopup="true" data-lib-trigger>
							<span class="lib-dot" style={`background:${library.accentDark}`} aria-hidden="true" />
							{library.name}
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
								<path d="m6 9 6 6 6-6" />
							</svg>
						</button>
						<div class="lib-menu" data-lib-menu hidden>
							{libraries.map((l) => (
								<a
									class="lib-option"
									href={href(l.id)}
									aria-current={l.id === library.id ? "true" : undefined}
								>
									<span class="lib-dot" style={`background:${l.accentDark}`} aria-hidden="true" />
									<span class="lib-option-text">
										<span class="lib-option-name">{l.name}</span>
										<span class="lib-option-tag">{l.tagline}</span>
									</span>
								</a>
							))}
						</div>
					</div>
				</>
			)
		}

		<nav class="header-nav" aria-label="Main">
			{
				!library &&
					libraries.map((l) => (
						<a class="header-link" href={href(l.id)}>
							{l.name}
						</a>
					))
			}
		</nav>

		<div class="header-actions">
			<button type="button" class="search-trigger" data-search-open aria-label="Search documentation">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
					<circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
				</svg>
				<span class="search-trigger-text">Search</span>
				<kbd class="search-kbd">⌘K</kbd>
			</button>

			<a class="icon-button" href={repoUrl} target="_blank" rel="noreferrer noopener" aria-label="View source on GitHub">
				<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
				</svg>
			</a>

			<button type="button" class="icon-button" data-theme-toggle aria-label="Toggle colour theme">
				<svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
				</svg>
				<svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
				</svg>
			</button>

			<button type="button" class="icon-button menu-button" data-sidebar-toggle aria-label="Toggle navigation">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M3 6h18M3 12h18M3 18h18" />
				</svg>
			</button>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		height: var(--header-h);
		background: color-mix(in oklab, var(--bg) 80%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		height: 100%;
		max-width: 100rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-weight: 600;
		font-size: 0.875rem;
		letter-spacing: -0.01em;
		flex-shrink: 0;
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 6px;
		background: var(--accent);
		color: var(--accent-contrast);
		font-weight: 700;
		font-size: 0.8rem;
	}
	.brand-name {
		color: var(--text);
	}

	.brand-divider {
		color: var(--text-faint);
		font-size: 1rem;
	}

	/* --- library switcher --------------------------------------------------- */

	.lib-switcher {
		position: relative;
	}

	.lib-trigger {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.5rem;
		border: 1px solid transparent;
		border-radius: var(--radius);
		background: transparent;
		font-size: 0.875rem;
		font-weight: 550;
		cursor: pointer;
		transition: background 0.15s var(--ease), border-color 0.15s var(--ease);
	}
	.lib-trigger:hover,
	.lib-trigger[aria-expanded="true"] {
		background: var(--bg-subtle);
		border-color: var(--border);
	}
	.lib-trigger svg {
		color: var(--text-faint);
	}

	.lib-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.lib-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		min-width: 20rem;
		padding: 0.3rem;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		box-shadow: 0 12px 32px -8px hsl(var(--shadow-color) / calc(var(--shadow-strength) + 18%));
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}
	.lib-menu[hidden] {
		display: none;
	}

	.lib-option {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		padding: 0.5rem 0.6rem;
		border-radius: 7px;
		transition: background 0.12s var(--ease);
	}
	.lib-option:hover {
		background: var(--bg-subtle);
	}
	.lib-option .lib-dot {
		margin-top: 0.42rem;
	}
	.lib-option[aria-current="true"] .lib-option-name {
		color: var(--accent);
	}
	.lib-option-text {
		display: flex;
		flex-direction: column;
		gap: 0.05rem;
		min-width: 0;
	}
	.lib-option-name {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--text);
	}
	.lib-option-tag {
		font-size: 0.75rem;
		color: var(--text-faint);
		line-height: 1.45;
	}

	/* --- nav ---------------------------------------------------------------- */

	.header-nav {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		margin-left: 0.5rem;
	}

	.header-link {
		padding: 0.3rem 0.6rem;
		border-radius: var(--radius);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--text-muted);
		transition: color 0.15s var(--ease), background 0.15s var(--ease);
	}
	.header-link:hover {
		color: var(--text);
		background: var(--bg-subtle);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin-left: auto;
	}

	/* --- search trigger ----------------------------------------------------- */

	.search-trigger {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 2rem;
		padding: 0 0.5rem 0 0.625rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-subtle);
		color: var(--text-faint);
		font-size: 0.8125rem;
		cursor: pointer;
		transition: border-color 0.15s var(--ease), color 0.15s var(--ease);
	}
	.search-trigger:hover {
		border-color: var(--border-strong);
		color: var(--text-muted);
	}
	.search-trigger-text {
		min-width: 5.5rem;
		text-align: left;
	}
	.search-kbd {
		font-family: var(--font-sans);
		font-size: 0.6875rem;
		padding: 0.1rem 0.3rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--bg);
		color: var(--text-faint);
	}

	.icon-button {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid transparent;
		border-radius: var(--radius);
		background: transparent;
		color: var(--text-muted);
		cursor: pointer;
		transition: color 0.15s var(--ease), background 0.15s var(--ease);
	}
	.icon-button:hover {
		color: var(--text);
		background: var(--bg-subtle);
	}

	.icon-moon {
		display: none;
	}
	:global(:root.dark) .icon-sun {
		display: none;
	}
	:global(:root.dark) .icon-moon {
		display: block;
	}

	.menu-button {
		display: none;
	}

	@media (max-width: 1100px) {
		.menu-button {
			display: grid;
		}
	}

	@media (max-width: 860px) {
		.header-nav,
		.brand-name,
		.search-trigger-text,
		.search-kbd {
			display: none;
		}
		.search-trigger {
			width: 2rem;
			padding: 0;
			justify-content: center;
		}
		.lib-menu {
			min-width: 16rem;
		}
	}
</style>

<script>
	// Library switcher dropdown.
	const trigger = document.querySelector<HTMLButtonElement>("[data-lib-trigger]");
	const menu = document.querySelector<HTMLElement>("[data-lib-menu]");

	if (trigger && menu) {
		const close = () => {
			menu.hidden = true;
			trigger.setAttribute("aria-expanded", "false");
		};

		trigger.addEventListener("click", (e) => {
			e.stopPropagation();
			const open = menu.hidden;
			menu.hidden = !open;
			trigger.setAttribute("aria-expanded", String(open));
		});

		document.addEventListener("click", (e) => {
			if (!menu.hidden && !menu.contains(e.target as Node)) close();
		});
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") close();
		});
	}
</script>
