---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/links.ts";
import { loadRegistry } from "../lib/registry.ts";

const libraries = loadRegistry();
---

<BaseLayout title="Page not found">
	<div class="container notfound">
		<p class="nf-code">404</p>
		<h1 class="nf-title">That page doesn't exist.</h1>
		<p class="nf-lede">It may have been renamed or moved. Try one of the libraries below.</p>
		<div class="nf-links">
			<a class="nf-link" href={href()}>Home</a>
			{libraries.map((l) => <a class="nf-link" href={href(l.id)}>{l.name}</a>)}
		</div>
	</div>
</BaseLayout>

<style>
	.notfound {
		padding-block: 7rem 9rem;
		text-align: center;
	}
	.nf-code {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--accent);
	}
	.nf-title {
		margin-top: 0.75rem;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.032em;
	}
	.nf-lede {
		margin-top: 0.75rem;
		color: var(--text-muted);
	}
	.nf-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 2rem;
	}
	.nf-link {
		padding: 0.45rem 0.9rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		font-size: 0.875rem;
		font-weight: 550;
		transition: border-color 0.15s var(--ease);
	}
	.nf-link:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>
